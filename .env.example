# Copy this file to .env and fill in your values.
# .env is gitignored — never commit it.

# ── Auth ────────────────────────────────────────────────────────────────────
# Token used by Grafana, Arize, Splunk, and Elasticsearch connectors.
MOCK_API_TOKEN=demo-token

# Dynatrace uses OAuth2 client credentials instead of a static token.
MOCK_CLIENT_ID=demo-client
MOCK_CLIENT_SECRET=demo-secret

# Set SIMULATE_ASYNC=true to exercise the Dynatrace polling path in the SRE Agent.
SIMULATE_ASYNC=false

# ── Domain ──────────────────────────────────────────────────────────────────
# Root domain for subdomain routing via Caddy. Subdomains will be:
#   grafana-mock.<HOLODECK_DOMAIN>
#   arize-mock.<HOLODECK_DOMAIN>
#   splunk-mock.<HOLODECK_DOMAIN>
#   elasticsearch-mock.<HOLODECK_DOMAIN>
# Leave blank (or skip) until you have Route 53 + Elastic IP configured.
HOLODECK_DOMAIN=holodeck.yourdomain.com

# ── S3 Fixtures (Phase 2 — leave blank for local file loading) ───────────────
# S3 bucket name where fixture JSON files are stored.
# When set, each mock pulls its scenarios.json from S3 at startup
# instead of reading from the local filesystem.
FIXTURES_S3_BUCKET=
