            disable_http_challenge
        }
    }
    reverse_proxy elasticsearch:3003
}

# Dynatrace Managed/ActiveGate canonical shape: {domain}:9999/e/{env-id}
# TLS cert is issued via TLS-ALPN-01 on port 443, served on 9999.
# Inbound 9999 is open to 0.0.0.0/0 on the security group (verified).
dynatrace.holodeck.scsandbox.net:9999 {
    tls {
        issuer acme {
            disable_http_challenge
        }
    }
    # Access logging is ON here so we can see the real client IP and
    # User-Agent of inbound requests (the app log only ever shows Caddy's
    # container IP). Needed to tell a genuine PagerDuty call apart from
    # our own curl tests and internet scanners.
    log {
        output stderr
        format json
    }
    reverse_proxy dynatrace:3004
}

# Same dynatrace mock on 443 as a fallback, in case PD's form rejects a
# port in the Environment URL. The mock serves the Managed path prefix
# (/e/{env-id}/...) as well as the bare SaaS paths, so
# https://dynatrace.holodeck.scsandbox.net/e/{env-id} works identically.
dynatrace.holodeck.scsandbox.net {
    tls {
        issuer acme {
            disable_http_challenge
        }
    }
    log {
        output stderr
        format json
    }
    reverse_proxy dynatrace:3004
}
